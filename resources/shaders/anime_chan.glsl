// Modified slower spinning version of Polar
// by FabriceNeyret https://www.shadertoy.com/view/ll2Bzd
// Yoga Mask generated with svg2shader.py

// --- INJECTED BACKGROUND SHADER ---
void renderBackground(out vec4 O, vec2 u) {
    vec2 U = u + u - u_Resolution.xy;
    float T = 6.2832, l = length(U) / 30., n = floor(l),
    a = fract((atan(U.x, U.y) - u_Time / (n - (n * .90))) / T) * n * 7.;
    O = (.6 + .4 * cos(n + floor(a) + vec4(0, 23, 21, 0)))
            * min(1., 3. - 6. * length(fract(vec2(l, a)) - .5));
}

