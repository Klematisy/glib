// 2D Polygon Distance Field (Credit: Inigo Quilez)
// *UPGRADED WITH AABB EARLY EXIT OPTIMIZATION*
float sdPolygon(in vec2[N] v, in vec2 p)
{
    // --- PERFORMANCE FIX: BOUNDING BOX CHECK ---
    // Calculate distance to a simple rectangular bounding box first.
    vec2 bboxCenter = vec2(-0.00000, -0.00000);
    vec2 bboxExtents = vec2(1.00000, 0.62318);
    vec2 q = abs(p - bboxCenter) - bboxExtents;
    float dBox = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);

    // If the pixel is comfortably outside the bounding box,
    // skip the massive loop entirely and just return the box distance.
    if (dBox > 0.05) return dBox;
    // -------------------------------------------

    float d = dot(p - v[0], p - v[0]);
    float s = 1.0;
    for (int i = 0, j = N - 1; i < N; j = i, i++)
    {
        vec2 e = v[j] - v[i];
        vec2 w = p - v[i];
        vec2 b = w - e * clamp(dot(w, e) / dot(e, e), 0.0, 1.0);
        d = min(d, dot(b, b));
        bvec3 c = bvec3(p.y >= v[i].y, p.y < v[j].y, e.x * w.y > e.y * w.x);
        if (all(c) || all(not(c))) s *= -1.0;
    }
    return s * sqrt(d);
}

void mainImage()
{
    // 1. Render the background shader
    vec4 bgCol = vec4(0.0);
    renderBackground(bgCol, gl_FragCoord.xy);

    // 2. Setup the mask coordinates
    vec2 uv = (gl_FragCoord.xy - u_Resolution.xy) / u_Resolution.y;
    uv *= 1.1;

    // 3. Calculate distance to the mask
    float d = sdPolygon(polygon, uv);

    float isOutside = smoothstep(0.0, 3.0 / u_Resolution.y, d);

    // 4. Mix
    vec3 exteriorColor = vec3(0.0);
    vec3 finalColor = mix(bgCol.rgb, exteriorColor, isOutside);

    o_Color = vec4(finalColor, 1.0);
}
